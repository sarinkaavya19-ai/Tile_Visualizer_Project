PORT=4000
NODE_ENV=development
# MongoDB Atlas connection string (optional locally — layout storage falls back to disk)
MONGODB_URI=mongodb://127.0.0.1:27017/tile-visualizer
# Admin seeded by `npm run db:seed`
# ADMIN_SEED_EMAIL=admin@example.com
# ADMIN_SEED_PASSWORD=admin123

# Client URL used to build password-reset links (no trailing slash)
CLIENT_URL=http://localhost:5173

# Authentication
JWT_SECRET=your_super_secret_key_here

# SMTP email delivery for the forgot-password flow. Leave SMTP_HOST empty in
# local dev — the server logs the would-be email payload instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Tile Visualizer <no-reply@tile-visualizer.local>
# How long password-reset tokens stay valid (minutes)
PASSWORD_RESET_TTL_MINUTES=60

# Cloudinary CDN (required for tile image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
